{
  "name": "career-workbench",
  "private": true,
  "description": "Local job application tracker, dashboard and discovery CLI",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:setup": "node scripts/setup-test-skills.js",
    "pretest": "node scripts/setup-test-skills.js",
    "test": "node --test dashboard/*.test.js discovery/*.test.js scripts/*.test.js lib/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skills:check": "node scripts/skills-sync.js",
    "skills:capture": "node scripts/skills-sync.js --capture",
    "skills:install": "node scripts/skills-sync.js --install"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
